# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android / Capacitor build files
/android/app/build/
/android/.gradle/
/android/build/
/android/capacitor-cordova-android-plugins/

# Local Python/cache files
__pycache__/

# Local build/log files
build-log.txt
build.log
build_export.log
build_plain.log

# Firebase local files
.firebase/